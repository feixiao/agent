# ==============================================================================
# Agentic Design Patterns & Harness LLM Environment Configuration
# ==============================================================================

# LLM 提供商：可选 "ollama" (默认本地) 或 "openai"
LLM_PROVIDER=ollama

# 模型名称：
# - Ollama 推荐："deepseek-r1:8b", "qwen3:8b", "deepseek-r1:14b"
# - OpenAI 推荐："gpt-4o-mini", "gpt-4o"
LLM_MODEL=deepseek-r1:8b

# Ollama 服务接口地址（默认 http://localhost:11434）
OLLAMA_HOST=http://localhost:11434

# 通用基础 API URL（若使用兼容 OpenAI 协议的网关，如 vLLM、OneAPI、LM Studio、DeepSeek 官方 API）
# LLM_BASE_URL=https://api.deepseek.com/v1

# OpenAI 配置（当 LLM_PROVIDER=openai 时使用）
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1

# 全局默认采样温度（可选）
LLM_TEMPERATURE=0.7
