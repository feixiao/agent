# ==============================================================================
# Agent LLM 配置 (通用兼容 OpenAI 协议接口)
# 支持 LM Studio、Ollama、vLLM、LocalAI 及各类云端大模型服务
# ==============================================================================

# 模型服务接口地址 (以 /v1 结尾)
# - LM Studio 示例:  http://localhost:1234/v1
# - Ollama 示例:     http://localhost:11434/v1
# - vLLM 示例:       http://localhost:8000/v1
LLM_BASE_URL=http://localhost:1234/v1

# 模型名称 (与本地服务中加载的模型保持一致)
LLM_MODEL=qwen3.8-27b-splash

# API Key (本地服务如 LM Studio / Ollama 无需真实 key，保留默认值即可；云端 API 请填真实 key)
LLM_API_KEY=not-needed

# 采样温度 (可选)
LLM_TEMPERATURE=0.7
