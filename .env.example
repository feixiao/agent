# ==============================================================================
# Agent LLM 配置
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 通用 OpenAI 兼容协议接口 (适用于 patterns/、本地 LM Studio、Ollama、vLLM)
# ------------------------------------------------------------------------------
# 模型服务接口地址 (以 /v1 结尾)
# - LM Studio 示例:  http://localhost:1234/v1
# - Ollama 示例:     http://localhost:11434/v1
# - vLLM 示例:       http://localhost:8000/v1
LLM_BASE_URL=http://localhost:1234/v1

# 模型名称 (与本地服务中加载的模型保持一致)
LLM_MODEL=qwen3.8-27b-splash

# API Key (本地服务无需真实 key，保留默认值即可；云端 API 请填真实 key)
LLM_API_KEY=not-needed

# 默认提供商 (默认采用通用 openai 兼容协议)
LLM_PROVIDER=openai

# 兼容标准 OpenAI SDK 及各章节代码默认识别的环境变量
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_MODEL=qwen3.8-27b-splash
OPENAI_API_KEY=not-needed

# 采样温度 (可选)
LLM_TEMPERATURE=0.7

# ------------------------------------------------------------------------------
# 2. 书籍配套实验章节 Providers 配置 (适用于 chapter1 - chapter10 与 agentbook)
# 根据实际使用的 Provider 按需填入对应 API Key 即可，无需全部填写
# ------------------------------------------------------------------------------

# --- 零成本方案 (Zero-Cost Options) ---
# 1. OpenRouter (免费模型，任意电脑可用，以 :free 结尾的模型零成本)
# OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# 2. Ollama 本地服务 (运行实验时可通过 --provider ollama 指定)
# OLLAMA_BASE_URL=http://localhost:11434/v1

# 3. ComfyUI 本地出图服务 (实验出图优先走本地 Qwen Image 2.1)
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_IMAGE_MODEL=qwen_image_2.1
IMAGE_PROVIDER=comfyui

# --- 各大厂商直连 API Key (Direct Provider Keys) ---
# Moonshot / Kimi (第 1 章实时搜索等实验需要)
# MOONSHOT_API_KEY=your-moonshot-key

# 字节跳动豆包 / 火山方舟 (Volcano Engine Ark)
# ARK_API_KEY=your-ark-key

# 硅基流动 SiliconFlow (Qwen 等模型)
# SILICONFLOW_API_KEY=your-siliconflow-key

# 阿里云百炼 DashScope (Qwen 等模型)
# DASHSCOPE_API_KEY=your-dashscope-key
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# 深度求索 DeepSeek
# DEEPSEEK_API_KEY=your-deepseek-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Krill AI (一站式全球主流模型 API)
# KRILL_API_KEY=your-krill-key
# KRILL_BASE_URL=https://api.krill-code.net/v1

# Atlas Cloud
# ATLASCLOUD_API_KEY=your-atlascloud-key
# ATLASCLOUD_BASE_URL=https://api.atlascloud.ai/v1

# 智谱清言 GLM
# ZHIPU_API_KEY=your-zhipu-key

# OpenAI
# OPENAI_API_KEY=your-openai-api-key

# Google Gemini (含免费额度)
# GEMINI_API_KEY=your-gemini-key
